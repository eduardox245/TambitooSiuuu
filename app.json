{
  "expo": {
    "name": "TAMBITOO",
    "slug": "tambitoo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tambitoo",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon",
      "supportsTablet": true,
      "infoPlist": {
        "NSFaceIDUsageDescription": "TAMBITOO utiliza Face ID para proteger el acceso a tu cuenta.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.tambitoo.tambitoo"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#168A65",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#168A65",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "TAMBITOO utiliza Face ID para proteger tu cuenta."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "2660e65e-8679-439c-85ef-c06bd747bcef"
      }
    },
    "owner": "tambitoo"
  }
}
